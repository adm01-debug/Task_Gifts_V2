# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Coverage report (gerado pelo CI, sobido como artifact — não versionar)
coverage/

.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets locais (nunca commitar)
.env

# Grafo de codigo (gerado por scripts/graphify/setup.sh; ~14 MB)
graphify-out/

# Contexto para agentes de IA: gerado pelo contexto.yml e publicado na branch `contexto`,
# nunca em main. Só `regras/manual/` (texto humano) é versionado aqui.
docs/contexto/*
!docs/contexto/regras/
docs/contexto/regras/*
!docs/contexto/regras/manual/

# Bytecode Python dos geradores de contexto
__pycache__/
*.pyc

# Estado local privado dos novos adaptadores de automação
/.tools/repo-automation/
/.tools/graphify/
