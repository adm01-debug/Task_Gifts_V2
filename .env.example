# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PRODUÇÃO
# ==============================================================================
# Copie este arquivo para .env e preencha com os valores reais

# SUPABASE
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# BITRIX24 (opcional - se integrado)
VITE_BITRIX_WEBHOOK_URL=https://promobrindes.bitrix24.com.br/rest/1/seu-webhook/

# APP CONFIG
VITE_APP_NAME=Sistema Empresarial
VITE_APP_ENV=production

# FEATURES FLAGS
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false

# EDGE FUNCTIONS — ALLOWLIST DEPLOYED
# Lista separada por vírgula das Edge Functions que já foram deployadas.
# Qualquer função NÃO listada aqui é bloqueada instantaneamente (sem request de rede).
# ATENÇÃO: vazio = TODAS bloqueadas (o código em src/lib/edgeAvailability.ts faz
# block-all quando a variável está vazia/ausente). Em produção/preview, preencha com
# a lista real; em dev local, use o kill-switch do localStorage para desabilitar, não a allowlist vazia.
# Lista canônica das functions invocadas pelo front (14):
VITE_DEPLOYED_EDGE_FUNCTIONS=verify-ip,admin-alerts,ai-coach,ai-course-builder,churn-prediction,competency-alerts,detect-new-device,generate-quiz-questions,push-device-revoked,push-public-key,reward-approval-review,send-campaign-push,trail-recommendations,webhook-dispatcher

# ==============================================================================
# IMPORTANTE: Nunca commitar o arquivo .env com valores reais!
# ==============================================================================
