# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PRODUÇÃO
# ==============================================================================
# Copie este arquivo para .env e preencha com os valores reais

# SUPABASE
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# BITRIX24 (opcional - se integrado)
VITE_BITRIX_WEBHOOK_URL=https://promobrindes.bitrix24.com.br/rest/1/seu-webhook/

# APP CONFIG
VITE_APP_NAME=Sistema Empresarial
VITE_APP_ENV=production

# FEATURES FLAGS
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false

# EDGE FUNCTIONS — ALLOWLIST DEPLOYED
# Lista separada por vírgula das Edge Functions que já foram deployadas.
# Qualquer função NÃO listada aqui é bloqueada instantaneamente (sem request de rede).
# Deixe vazio durante desenvolvimento local (todas liberadas), e preencha após cada deploy.
# Exemplo: VITE_DEPLOYED_EDGE_FUNCTIONS=verify-ip,verify-geo,ai-coach,admin-alerts
# VITE_DEPLOYED_EDGE_FUNCTIONS=

# ==============================================================================
# IMPORTANTE: Nunca commitar o arquivo .env com valores reais!
# ==============================================================================
