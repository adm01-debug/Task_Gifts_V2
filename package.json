    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "lovable-tagger": "^1.3.5",
    "md-to-pdf": "^5.2.5",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
